
const express = require("express");
const http = require("http");
const path = require("path");
const { Server } = require("socket.io");

const app = express();
const server = http.createServer(app);

const io = new Server(server, {
  cors: { origin: "*" }
});

const PORT = process.env.PORT || 3000;
const GAME_URL = "https://high-five-drivingoops.onrender.com/";

app.get("/sitemap.txt", (req, res) => {
  res.type("text/plain");
  res.send(GAME_URL + "\n");
});

app.get("/robots.txt", (req, res) => {
  res.type("text/plain");
  res.send(
    "User-agent: *\n" +
    "Allow: /\n" +
    "Sitemap: " + GAME_URL + "sitemap.txt\n"
  );
});

app.use(express.static(__dirname));

app.get("/", (req, res) => {
  res.sendFile(path.join(__dirname, "index.html"));
});

let waitingPlayer = null;
const matches = new Map();

function removeFromQueue(socket) {
  if (waitingPlayer === socket) {
    waitingPlayer = null;
  }
}

function leaveMatch(socket, notifyOpponent = true) {
  const match = matches.get(socket.id);
  if (!match) return;

  const opponentId =
    match.player1 === socket.id ? match.player2 : match.player1;

  matches.delete(match.player1);
  matches.delete(match.player2);

  socket.leave(match.room);

  if (notifyOpponent) {
    const opponent = io.sockets.sockets.get(opponentId);
    if (opponent) {
      opponent.emit("opponentLeft");
      opponent.leave(match.room);
    }
  }
}

io.on("connection", (socket) => {
  console.log("Oyuncu bağlandı:", socket.id);

  socket.on("joinQueue", (data = {}) => {
    removeFromQueue(socket);

    if (matches.has(socket.id)) {
      leaveMatch(socket);
    }

    if (waitingPlayer && !waitingPlayer.connected) {
      waitingPlayer = null;
    }

    if (!waitingPlayer || waitingPlayer.id === socket.id) {
      waitingPlayer = socket;
      socket.emit("queued");
      console.log("Rakip bekleniyor:", socket.id);
      return;
    }

    const opponent = waitingPlayer;
    waitingPlayer = null;

    const room = "race-" + opponent.id + "-" + socket.id;

    const match = {
      room,
      player1: opponent.id,
      player2: socket.id,
      finished: new Set()
    };

    matches.set(opponent.id, match);
    matches.set(socket.id, match);

    opponent.join(room);
    socket.join(room);

    opponent.emit("matched", {
      lane: 0,
      opponentCar: Number.isInteger(data.car) ? data.car : 0
    });

    socket.emit("matched", {
      lane: 1,
      opponentCar: 0
    });

    console.log("Yarış başladı:", room);
  });

  socket.on("playerState", (state = {}) => {
    const match = matches.get(socket.id);
    if (!match) return;

    socket.to(match.room).emit("opponentState", {
      x: Number(state.x) || 0,
      z: Number(state.z) || 0,
      speed: Number(state.speed) || 0,
      yaw: Number(state.yaw) || 0,
      car: Number(state.car) || 0
    });
  });

  socket.on("finishRace", () => {
    const match = matches.get(socket.id);
    if (!match || match.finished.size > 0) return;

    match.finished.add(socket.id);

    io.to(match.room).emit("raceResult", {
      winnerId: socket.id
    });

    console.log("Yarış bitişi:", socket.id);
  });

  socket.on("cancelQueue", () => {
    removeFromQueue(socket);
    leaveMatch(socket);
  });

  socket.on("disconnect", () => {
    removeFromQueue(socket);
    leaveMatch(socket);
    console.log("Oyuncu ayrıldı:", socket.id);
  });
});

server.listen(PORT, "0.0.0.0", () => {
  console.log("Otoyol Sürücüsü çalışıyor. Port:", PORT);
});
